DATABASE_URL=postgresql+psycopg://dashboard:dashboard@postgres:5432/dashboard

OPENCART_HOST=opencart-db
OPENCART_PORT=3306
OPENCART_USER=opencart
OPENCART_PASSWORD=opencart_pass
OPENCART_DB=opencart
OPENCART_PREFIX=oc_

SYNC_INTERVAL_MINUTES=5
TIMEZONE=Europe/Kyiv
CURRENCY=UAH
EXCLUDED_STATUSES=["Canceled","Canceled Reversal","Chargeback","Denied","Expired","Failed","Refunded","Reversed","Voided"]
FULL_SYNC_INTERVAL_HOURS=24
GITHUB_URL=

# Telegram bot (keep real values only in the local, untracked .env)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_MORNING_REPORT_TIME=09:00
LOW_STOCK_THRESHOLD=5

# Публичное демо: сгенерируй длинный случайный токен и не публикуй его.
DEMO_ACTION_TOKEN=
# true только для облачного портфолио без подключения к OpenCart.
DEMO_MODE=false
# Если приложение доступно только через reverse proxy, укажи его IP/CIDR,
# например 172.20.0.0/16. Без этого X-Forwarded-For намеренно игнорируется.
TRUSTED_PROXY_IPS=
SIMULATE_COOLDOWN_SECONDS=10
SIMULATE_LIMIT_PER_HOUR=6
